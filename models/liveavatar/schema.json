{
  "openapi": "3.1.0",
  "info": {
    "title": "liveavatar",
    "version": "v0.0.0",
    "description": ""
  },
  "x-reactor": {
    "tracks": [
      {
        "name": "main_video",
        "kind": "video",
        "direction": "out"
      },
      {
        "name": "main_audio",
        "kind": "audio",
        "direction": "out"
      }
    ]
  },
  "paths": {
    "/events/set_avatar_image": {
      "post": {
        "operationId": "set_avatar_image",
        "summary": "Select an uploaded identity image while idle. Replies `input_accepted` and broadcasts `state_update`; invalid images or an active take return `command_error`. Required before `start`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "$ref": "#/components/schemas/ReactorUploadReference",
                    "description": "PNG, JPEG or WebP reference, up to 25 MiB; aspect ratio is fitted by the model. Applies at the next `start`; no default image is supplied.",
                    "x-reactor-moderate": true
                  }
                },
                "required": [
                  "image"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "InputAccepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputAccepted"
                }
              }
            }
          }
        }
      }
    },
    "/events/set_audio": {
      "post": {
        "operationId": "set_audio",
        "summary": "Select uploaded driving audio while idle. Replies `input_accepted` and broadcasts `state_update`; unreadable audio or an active take return `command_error`. Required before `start`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "audio": {
                    "$ref": "#/components/schemas/ReactorUploadReference",
                    "description": "WAV, FLAC or MP3 audio up to 100 MiB, decoded to mono 16 kHz. Drives and is played with the next take; video ends at the audio or requested clip limit.",
                    "x-reactor-moderate": true
                  }
                },
                "required": [
                  "audio"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "InputAccepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputAccepted"
                }
              }
            }
          }
        }
      }
    },
    "/events/set_pose_video": {
      "post": {
        "operationId": "set_pose_video",
        "summary": "Select or clear a pose-conditioning upload while idle. Replies `input_accepted` and broadcasts `state_update`; unreadable videos or an active take return `command_error`. The reference image and audio remain required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pose_video": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/ReactorUploadReference"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Optional MP4 containing a prepared pose sequence, not a request to extract pose from ordinary footage. Null clears it; applies at the next `start`.",
                    "x-reactor-moderate": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "InputAccepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputAccepted"
                }
              }
            }
          }
        }
      }
    },
    "/events/set_prompt": {
      "post": {
        "operationId": "set_prompt",
        "summary": "Set optional scene text while idle. Replies `input_accepted` and broadcasts `state_update`; an active take returns `command_error`. Text describes appearance or motion, not speech synthesis. Negative text is accepted for compatibility but does not influence this four-step model.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "prompt": {
                    "type": "string",
                    "default": "",
                    "description": "Optional scene and performance description applied at `start`; empty uses image and audio without additional scene text.",
                    "maxLength": 4096,
                    "x-reactor-moderate": true
                  },
                  "negative_prompt": {
                    "type": "string",
                    "default": "",
                    "description": "Compatibility text passed at `start`; empty retains the upstream default. The released four-step model does not apply negative conditioning, so this field does not change the video.",
                    "maxLength": 4096,
                    "x-reactor-moderate": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "InputAccepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputAccepted"
                }
              }
            }
          }
        }
      }
    },
    "/events/set_generation_options": {
      "post": {
        "operationId": "set_generation_options",
        "summary": "Set sampling seed and clip limit while idle without starting generation. Applies on the next explicit `start`. Replies `input_accepted` and broadcasts `state_update`; an active take returns `command_error`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "seed": {
                    "type": "integer",
                    "default": 420,
                    "description": "Sampling seed for the next `start`; each successive clip uses seed plus its zero-based clip index. Does not start generation.",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "x-reactor-moderate": false
                  },
                  "max_chunks": {
                    "type": "integer",
                    "default": 10000,
                    "description": "Maximum clips for the next `start`; defaults to 10000, and audio length may end the take earlier. Does not start generation.",
                    "minimum": 1,
                    "maximum": 10000,
                    "x-reactor-moderate": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "InputAccepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InputAccepted"
                }
              }
            }
          }
        }
      }
    },
    "/events/start": {
      "post": {
        "operationId": "start",
        "summary": "Begin generation explicitly after all desired inputs have been accepted. Valid only while idle with both `set_avatar_image` and `set_audio` completed; prompt and generation options are optional. Replies `take_changed` and broadcasts `state_update`; missing inputs or an active take return `command_error`. Uploading or adjusting inputs alone never starts generation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TakeChanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TakeChanged"
                }
              }
            }
          }
        }
      }
    },
    "/events/stop": {
      "post": {
        "operationId": "stop",
        "summary": "End an active or idle take, retaining uploads and text for another `start`. Replies `take_changed` and broadcasts `state_update`; waits for an in-flight clip to finish safely and flushes queued output.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TakeChanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TakeChanged"
                }
              }
            }
          }
        }
      }
    },
    "/events/reset": {
      "post": {
        "operationId": "reset",
        "summary": "End the take and clear uploaded inputs, prompts and progress in any session state. Replies `take_changed` and broadcasts `state_update`; upload a new image and audio before `start`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TakeChanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TakeChanged"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "state_update": {
      "post": {
        "operationId": "state_update",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StateUpdate"
              }
            }
          }
        },
        "summary": "Emitted on connection and after each accepted change or completed clip."
      }
    },
    "input_accepted": {
      "post": {
        "operationId": "input_accepted",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InputAccepted"
              }
            }
          }
        },
        "summary": "Emitted as the reply when an uploaded input, prompt, or generation options are accepted."
      }
    },
    "take_changed": {
      "post": {
        "operationId": "take_changed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TakeChanged"
              }
            }
          }
        },
        "summary": "Emitted as the reply when start, stop, or reset succeeds."
      }
    },
    "chunk_complete": {
      "post": {
        "operationId": "chunk_complete",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChunkComplete"
              }
            }
          }
        },
        "summary": "Emitted once for each generated clip sent on main_video and main_audio."
      }
    },
    "generation_ended": {
      "post": {
        "operationId": "generation_ended",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationEnded"
              }
            }
          }
        },
        "summary": "Emitted when a take reaches its limit or fails during generation."
      }
    }
  },
  "components": {
    "schemas": {
      "ReactorUploadReference": {
        "type": "object",
        "format": "reactor-upload-reference",
        "description": "Reference to a file uploaded via the Reactor upload protocol.",
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "upload_id",
          "name",
          "mime_type",
          "size"
        ]
      },
      "StateUpdate": {
        "type": "object",
        "properties": {
          "image_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Selected uploaded reference filename, or null until `set_avatar_image`."
          },
          "audio_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Selected uploaded driving audio filename, or null until `set_audio`."
          },
          "pose_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional uploaded pose video filename; null means audio-driven motion only."
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Scene description for the next take; null means no text condition."
          },
          "negative_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Requested exclusions, or null to use the released model default."
          },
          "seed": {
            "type": "integer",
            "description": "Seed read at `start`; retained by `stop` and restored to 420 by `reset`."
          },
          "ready": {
            "type": "boolean",
            "description": "Whether both reference image and driving audio have been selected."
          },
          "running": {
            "type": "boolean",
            "description": "Whether a take is active after an accepted explicit `start`."
          },
          "completed_chunks": {
            "type": "integer",
            "description": "Number of clips delivered in the current or most recent take."
          },
          "frames": {
            "type": "integer",
            "description": "Video frames delivered this take at 25 frames per second."
          },
          "max_chunks": {
            "type": "integer",
            "description": "Clip limit selected by `set_generation_options` and read at `start`; audio can end the take earlier."
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Most recent generation failure, or null when no failure occurred."
          }
        },
        "required": [
          "image_name",
          "audio_name",
          "pose_name",
          "prompt",
          "negative_prompt",
          "seed",
          "ready",
          "running",
          "completed_chunks",
          "frames",
          "max_chunks",
          "error"
        ]
      },
      "InputAccepted": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Accepted condition: avatar_image, audio, pose_video, prompt, or generation_options."
          }
        },
        "required": [
          "field"
        ]
      },
      "TakeChanged": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "Accepted command wire name; state details follow in `state_update`."
          }
        },
        "required": [
          "action"
        ]
      },
      "ChunkComplete": {
        "type": "object",
        "properties": {
          "chunk": {
            "type": "integer",
            "description": "One-based completed clip number, reset at `start`."
          },
          "frames": {
            "type": "integer",
            "description": "Frames in this clip: 45 in the first clip, then 48 at 25 FPS."
          }
        },
        "required": [
          "chunk",
          "frames"
        ]
      },
      "GenerationEnded": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "complete for normal completion; otherwise the reported failure."
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  }
}
